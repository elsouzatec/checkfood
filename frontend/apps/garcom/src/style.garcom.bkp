@import '@shared/tokens.css';
@import '@shared/reset.css';
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
@import '@shared/app-header.css';
@import '@shared/buttons.css';
@import '@shared/forms.css';
@import '@shared/badges.css';
@import '@shared/states.css';
@import '@shared/fullscreen.css';

/* ============================================================
   PagFood · App GARÇOM (mobile)
   Mesmo vocabulário visual do cliente:
   · Verde folha = identidade / valores / marca
   · Laranja torrado = ações / CTAs / estado ativo
   · Status tokens preservados
============================================================ */

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--font-base);
  background: var(--page-bg);
  color: var(--text-primary);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

#app { min-height: 100vh; }

/* ── Header ── */
.app-header {
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  padding: 12px 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: var(--z-header);
  border-bottom: 3px solid var(--sidebar-active-border);
}
.app-header h1 {
  font-size: var(--fs-xl);
  font-weight: var(--fw-black);
  color: var(--sidebar-text);
  letter-spacing: 0.2px;
}
.header-user {
  display: flex;
  align-items: center;
  gap: 12px;
}
.header-user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}
.header-user-name {
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  color: #FFFFFF;
  line-height: 1.1;
}
.role-badge {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  letter-spacing: 0.3px;
  line-height: 1.2;
}
.logout-btn {
  background: none;
  border: none;
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  cursor: pointer;
  padding: 6px 8px;
  font-family: inherit;
  border-radius: var(--radius-xs);
  transition: background var(--dur-fast);
}
.logout-btn:hover { background: rgba(255, 255, 255, 0.12); }

/* ── Bottom nav ── */
.bottom-nav {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--sidebar-bg);
  display: flex;
  z-index: var(--z-header);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
}
.nav-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 10px 6px;
  color: var(--sidebar-text-muted);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  text-decoration: none;
  transition: color var(--dur-fast), background var(--dur-fast);
  border-top: 3px solid transparent;
  min-height: 60px;
}
.nav-tab.active {
  color: #FFFFFF;
  background: var(--sidebar-active-bg);
  border-top-color: var(--sidebar-active-border);
}
.nav-tab-icon { font-size: 22px; line-height: 1; }

/* ── Botões ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 12px;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--fs-md);
  font-weight: var(--fw-semibold);
  cursor: pointer;
  transition: background var(--dur-normal), transform var(--dur-fast);
  font-family: var(--font-base);
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn:active:not(:disabled) { transform: scale(0.98); }

.btn-primary   { background: var(--brand-accent); color: var(--brand-accent-text); width: 100%; }
.btn-primary:hover:not(:disabled) { background: var(--brand-accent-hover); }
.btn-secondary { background: var(--gray-100); color: var(--text-secondary); }
.btn-secondary:hover:not(:disabled) { background: var(--gray-200); }
.btn-success   { background: var(--status-success-color); color: #fff; }
.btn-danger    { background: var(--status-danger-color);  color: #fff; }
.btn-sm        { padding: 8px 14px; font-size: var(--fs-sm); width: auto; }

/* Botão primário "fechar conta" — gradiente suave verde→verde-escuro (identidade + peso) */
.btn-close-bill {
  width: 100%;
  background: var(--brand-accent);
  color: #FFFFFF;
  border: none;
  padding: 14px;
  border-radius: var(--radius);
  font-size: var(--fs-lg);
  font-weight: var(--fw-bold);
  cursor: pointer;
  font-family: inherit;
  transition: background var(--dur-normal), transform var(--dur-fast);
  box-shadow: 0 4px 12px rgba(221, 111, 45, 0.28);
}
.btn-close-bill:hover:not(:disabled) { background: var(--brand-accent-hover); }
.btn-close-bill:active:not(:disabled) { transform: scale(0.98); }

/* ── Página ── */
.page {
  padding: 16px 16px 90px;
  max-width: 700px;
  margin: 0 auto;
}
.section-title {
  font-size: var(--fs-lg);
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  margin-bottom: 12px;
  margin-top: 4px;
}

/* ── Cards genéricos ── */
.card {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--border-subtle);
  overflow: hidden;
  margin-bottom: 12px;
}

/* ── Cards de pedido (usado em ReadyOrders e TableOrders) ── */
.order-card {
  background: var(--surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius);
  padding: 14px 16px;
  margin-bottom: 12px;
  box-shadow: var(--shadow-sm);
}
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-bottom: 10px;
  margin-bottom: 10px;
  border-bottom: 1px solid var(--border-subtle);
}
.order-id {
  font-weight: var(--fw-bold);
  font-size: var(--fs-md);
  color: var(--text-primary);
}
.order-items-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.order-items-list li {
  display: flex;
  align-items: baseline;
  gap: 4px;
  font-size: var(--fs-sm);
  padding: 6px 0;
  color: var(--text-secondary);
  border-bottom: 1px dashed var(--border-subtle);
}
.order-items-list li:last-child { border-bottom: none; }
.order-actions {
  display: flex;
  gap: 8px;
  margin-top: 12px;
  flex-wrap: wrap;
}
.order-total {
  text-align: right;
  font-weight: var(--fw-bold);
  color: var(--brand-primary);
  font-size: var(--fs-md);
  margin-top: 8px;
  font-variant-numeric: tabular-nums;
}

/* ── Status badges ── */
.status-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: var(--fw-bold);
  white-space: nowrap;
}
.status-badge.status-pendente_validacao { background: var(--status-pending-bg);   color: var(--status-pending-color); }
.status-badge.status-confirmado         { background: var(--status-received-bg);  color: var(--status-received-color); }
.status-badge.status-preparando         { background: var(--status-preparing-bg); color: var(--status-preparing-color); }
.status-badge.status-pronto             { background: var(--status-ready-bg);     color: var(--status-ready-color); }
.status-badge.status-entregue           { background: var(--status-delivered-bg); color: var(--status-delivered-color); }
.status-badge.status-pago               { background: var(--gray-100);            color: var(--text-muted); }
.status-badge.status-cancelado          { background: var(--gray-100);            color: var(--text-muted); }

/* ── Área pill (cozinha/bar/lanchonete) ── */
.area-pill {
  display: inline-block;
  padding: 3px 10px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: var(--fw-bold);
  margin-bottom: 6px;
  border: 1px solid;
}

/* ── Mapa de mesas ── */
.tables-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.table-card {
  background: var(--surface);
  border: 3px solid var(--border-default);
  border-radius: var(--radius);
  padding: 14px 10px;
  text-align: center;
  cursor: pointer;
  transition: transform var(--dur-fast), box-shadow var(--dur-fast), border-color var(--dur-fast);
  position: relative;
  user-select: none;
}
.table-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }

.table-number {
  font-size: 24px;
  font-weight: var(--fw-black);
  color: var(--brand-primary);
  line-height: 1;
}
.table-label {
  font-size: var(--fs-xs);
  color: var(--text-muted);
  margin-top: 6px;
  text-transform: uppercase;
  font-weight: var(--fw-semibold);
  letter-spacing: 0.3px;
}

/* Prioridades por status do pedido na mesa */
.priority-pending   { border-color: var(--status-pending-border);   background: var(--status-pending-bg);   animation: pulse-border 2s infinite; }
.priority-ready     { border-color: var(--status-ready-border);     background: var(--status-ready-bg); }
.priority-preparing { border-color: var(--status-preparing-border); background: var(--status-preparing-bg); }
.priority-received  { border-color: var(--status-received-border);  background: var(--status-received-bg); }
.priority-delivered { border-color: var(--status-delivered-border); background: var(--status-delivered-bg); }
.priority-occupied  { border-color: var(--border-default); background: var(--surface-sunken); }
.priority-free      { border-color: var(--border-default); background: var(--surface); }

.priority-pending .table-number   { color: var(--status-pending-color); }
.priority-ready .table-number     { color: var(--status-ready-color); }
.priority-preparing .table-number { color: var(--status-preparing-color); }
.priority-received .table-number  { color: var(--status-received-color); }
.priority-delivered .table-number { color: var(--status-delivered-color); }

@keyframes pulse-border {
  0%, 100% { box-shadow: 0 0 0 0 rgba(230, 57, 70, 0); }
  50%      { box-shadow: 0 0 0 4px rgba(230, 57, 70, 0.18); }
}

.badge-count {
  position: absolute;
  top: -8px; right: -8px;
  background: var(--status-danger-color);
  color: #FFFFFF;
  font-size: var(--fs-xs);
  font-weight: var(--fw-bold);
  border-radius: 50%;
  width: 22px; height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(230, 57, 70, 0.4);
}

/* ── Legenda ── */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 8px 0 14px;
  font-size: var(--fs-xs);
  color: var(--text-muted);
}
.legend-item { display: flex; align-items: center; gap: 5px; }
.legend-dot  { width: 10px; height: 10px; border-radius: 50%; }
.dot-pending   { background: var(--status-pending-color); }
.dot-ready     { background: var(--status-ready-color); }
.dot-preparing { background: var(--status-preparing-color); }
.dot-received  { background: var(--status-received-color); }
.dot-delivered { background: var(--status-delivered-color); }
.dot-free      { background: var(--border-default); }

/* ── Inputs ── */
.form-group { margin-bottom: 14px; }
.form-group label {
  display: block;
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  margin-bottom: 6px;
  color: var(--text-secondary);
}
.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 11px 14px;
  border: 1.5px solid var(--border-default);
  border-radius: var(--radius-sm);
  font-size: 15px;
  background: var(--surface);
  color: var(--text-primary);
  outline: none;
  font-family: var(--font-base);
  transition: border-color var(--dur-fast);
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus { border-color: var(--brand-accent); }

/* ── Estados / mensagens ── */
.loading     { text-align: center; padding: 40px;    color: var(--text-muted); font-size: var(--fs-md); }
.empty-state { text-align: center; padding: 48px 20px; color: var(--text-muted); font-size: var(--fs-md); }

.error-msg {
  background: var(--status-pending-bg);
  color: var(--status-pending-color);
  border: 1px solid var(--status-pending-border);
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  margin-bottom: 14px;
}

/* ── Banner de chamados de mesa ── */
.calls-banner {
  background: var(--status-received-bg);
  border: 1.5px solid var(--status-received-border);
  border-radius: var(--radius);
  padding: 12px 14px;
  margin-bottom: 16px;
}
.calls-title {
  font-size: var(--fs-sm);
  font-weight: var(--fw-bold);
  color: var(--status-received-color);
  margin-bottom: 8px;
}
.call-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 8px 10px;
  background: rgba(255, 255, 255, 0.6);
  border-radius: var(--radius-sm);
  margin-bottom: 6px;
}
.call-item:last-child { margin-bottom: 0; }
.call-info    { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.call-table   { font-size: var(--fs-md); font-weight: var(--fw-bold); color: var(--text-primary); }
.call-client  { font-size: var(--fs-xs); color: var(--text-muted); }
.call-dismiss-btn {
  background: var(--status-success-color);
  color: #FFFFFF;
  border: none;
  padding: 7px 14px;
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  font-weight: var(--fw-bold);
  cursor: pointer;
  font-family: var(--font-base);
  transition: background var(--dur-normal);
  white-space: nowrap;
}
.call-dismiss-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.call-dismiss-btn:active:not(:disabled) { transform: scale(0.98); }

/* ── Login fullscreen (compartilhado c/ cozinha) ── */
.fullscreen-center {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
  text-align: center;
  background: var(--sidebar-bg);
  color: #FFFFFF;
}
.fullscreen-center h2 {
  font-size: var(--fs-2xl);
  margin-bottom: 8px;
  color: #FFFFFF;
}
.fullscreen-center p {
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 32px;
  font-size: var(--fs-md);
}
.logo-text {
  font-size: 32px;
  font-weight: var(--fw-black);
  color: var(--brand-accent);
  margin-bottom: 24px;
  letter-spacing: -0.5px;
}

/* ── Login toggle (phone / apelido) ── */
.login-toggle {
  display: flex;
  gap: 8px;
  margin-bottom: 20px;
}
.toggle-btn {
  flex: 1;
  padding: 10px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  cursor: pointer;
  font-family: inherit;
  transition: border-color var(--dur-fast), background var(--dur-fast), color var(--dur-fast);
}
.toggle-btn.active {
  border-color: var(--brand-accent);
  background: rgba(221, 111, 45, 0.18);
  color: #FFFFFF;
}

/* Inputs no fundo dark (login) ficam com variante clara */
.fullscreen-center .form-group label {
  color: rgba(255, 255, 255, 0.85);
}
.fullscreen-center .form-group input {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}
.fullscreen-center .form-group input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}
.fullscreen-center .form-group input:focus {
  border-color: var(--brand-accent);
  background: rgba(255, 255, 255, 0.12);
}
.fullscreen-center .error-msg {
  background: rgba(230, 57, 70, 0.2);
  border-color: rgba(230, 57, 70, 0.4);
  color: #FFB3B9;
}
