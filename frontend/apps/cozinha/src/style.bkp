@import '@shared/tokens.css';
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');
@import '@shared/app-header.css';

/* ============================================================
   PagFood · App COZINHA (KDS)
   Onda 5: cards ainda mais densos. Header em 3 colunas,
   ação por 2 toques, contorno tracejado nos itens.
============================================================ */

*, *::before, *::after { margin: 0; padding: 0; }

body {
  font-family: var(--font-base);
  background: var(--kds-bg);
  color: var(--kds-text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

#app { min-height: 100vh; }

/* ── Header global ── */
.app-header {
  background: var(--sidebar-bg);
  color: var(--sidebar-text);
  padding: 10px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 3px solid var(--sidebar-active-border);
  position: sticky;
  top: 0;
  z-index: var(--z-header);
}
.app-header h1 {
  font-size: var(--fs-xl);
  font-weight: var(--fw-black);
  color: var(--sidebar-text);
  letter-spacing: 0.3px;
}
.header-logout-btn {
  background: none;
  border: 1px solid rgba(255, 255, 255, 0.20);
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  cursor: pointer;
  padding: 6px 14px;
  font-family: inherit;
  border-radius: var(--radius-sm);
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}
.header-logout-btn:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.40);
  color: #FFFFFF;
}

/* ── Botões (login principalmente) ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 10px 16px;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--fs-md);
  font-weight: var(--fw-bold);
  cursor: pointer;
  transition: background var(--dur-normal), transform var(--dur-fast);
  font-family: var(--font-base);
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn:active:not(:disabled) { transform: scale(0.98); }

.btn-primary { background: var(--brand-accent); color: var(--brand-accent-text); width: 100%; }
.btn-primary:hover:not(:disabled) { background: var(--brand-accent-hover); }

/* ════════════════════════════════════════════
   KDS — KANBAN
════════════════════════════════════════════ */
.kds-container {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
  padding: 12px 16px;
  min-height: calc(100vh - 180px);
}

.kds-column {
  background: var(--kds-surface);
  border-radius: var(--radius-sm);
  border: 1px solid var(--kds-border);
  display: flex;
  flex-direction: column;
  max-height: calc(100vh - 160px);
  overflow: hidden;
}

/* Header da coluna — sticky, colorido por status */
.kds-column-title {
  font-weight: var(--fw-black);
  text-transform: uppercase;
  letter-spacing: 0.6px;
  text-align: center;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  border-bottom: 2px solid;
  position: sticky;
  top: 0;
  z-index: 2;
}
.col-fila .kds-column-title {
  background: var(--status-received-bg);
  color: var(--status-received-color);
  border-bottom-color: var(--status-received-border);
}
.col-preparando .kds-column-title {
  background: var(--status-preparing-bg);
  color: var(--status-preparing-color);
  border-bottom-color: var(--status-preparing-border);
}
.col-pronto .kds-column-title {
  background: var(--status-ready-bg);
  color: var(--status-ready-color);
  border-bottom-color: var(--status-ready-border);
}

.kds-column { overflow-y: auto; }

.kds-empty {
  padding: 24px 16px;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--kds-text-muted);
  font-style: italic;
}

/* ── Card (compacto + clicável) ── */
.kds-card {
  background: var(--surface);
  color: var(--text-primary);
  border-radius: var(--radius-sm);
  margin: 6px 8px;
  padding: 8px 10px;
  box-shadow: var(--shadow-sm);
  border: 1.5px solid var(--border-subtle);
  cursor: pointer;
  user-select: none;
  transition:
    transform var(--dur-fast),
    border-color var(--dur-fast),
    box-shadow var(--dur-fast),
    background var(--dur-fast);
}
.kds-card:first-of-type { margin-top: 8px; }
.kds-card:last-of-type  { margin-bottom: 10px; }

/* Hover/active — sinaliza que o card inteiro é um botão */
.kds-card:hover:not(.kds-card-done):not(.kds-card-loading) {
  transform: translateY(-1px);
  border-color: var(--brand-accent);
  box-shadow: var(--shadow);
}
.kds-card:active:not(.kds-card-done):not(.kds-card-loading) {
  transform: scale(0.985);
}

/* Primeiro toque armado — aguardando confirmação */
.kds-card.kds-card-confirming {
  border: 2px solid var(--brand-accent);
  background: #FFF5EE;
  box-shadow: 0 0 0 4px var(--brand-accent-soft);
  transform: translateY(-1px);
}

/* Card em Pronto — sem interação */
.kds-card-done {
  cursor: default;
  opacity: 0.72;
}

/* Card durante a chamada de API — desativa */
.kds-card-loading {
  opacity: 0.55;
  pointer-events: none;
}

/* ── Header do card em 3 colunas (ID | Mesa | Tempo) ── */
.kds-card-header {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 6px;
  padding-bottom: 6px;
  margin-bottom: 6px;
  border-bottom: 1px solid var(--border-subtle);
}
.kds-order-id {
  justify-self: start;
  font-weight: var(--fw-black);
  font-size: var(--fs-md);
  color: var(--text-primary);
  letter-spacing: -0.3px;
  font-variant-numeric: tabular-nums;
}
.kds-table {
  justify-self: center;
  background: var(--brand-accent-soft);
  color: var(--brand-accent);
  padding: 2px 10px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  font-weight: var(--fw-black);
  white-space: nowrap;
}
.kds-time {
  justify-self: end;
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.kds-time::before {
  content: '⏱ ';
  opacity: 0.6;
}
.kds-time.urgent {
  color: var(--status-danger-color);
  font-weight: var(--fw-black);
}

/* ── Items com CONTORNO tracejado (reforça que o card é pressionável) ── */
.kds-items {
  list-style: none;
  padding: 6px 10px;
  margin: 0;
  border: 1px dashed rgba(50, 104, 13, 0.30);
  border-radius: var(--radius-xs);
  background: rgba(50, 104, 13, 0.02);
}
.kds-items li {
  font-size: var(--fs-sm);
  padding: 3px 0;
  line-height: 1.35;
  color: var(--text-primary);
  border-bottom: 1px solid var(--border-subtle);
}
.kds-items li:last-child { border-bottom: none; }
.kds-items li strong {
  color: var(--brand-primary);
  font-weight: var(--fw-black);
  margin-right: 2px;
  font-variant-numeric: tabular-nums;
}

/* Em cartões Pronto (sem ação), simplifica: remove o contorno e fundo */
.kds-card-done .kds-items {
  border: none;
  background: transparent;
  padding: 4px 0;
}

/* Ao confirmar, o contorno dos items fica laranja para reforçar armado */
.kds-card.kds-card-confirming .kds-items {
  border-color: var(--brand-accent);
  background: rgba(221, 111, 45, 0.04);
}

/* Observações no item */
.kds-item-notes {
  font-size: var(--fs-xs);
  color: var(--status-danger-color);
  font-weight: var(--fw-semibold);
  margin-top: 3px;
  padding: 3px 6px;
  background: var(--status-pending-bg);
  border-radius: var(--radius-xs);
  display: inline-block;
  line-height: 1.3;
}

/* Hint de confirmação (substitui o botão) */
.kds-confirm-hint {
  margin-top: 7px;
  padding: 6px 10px;
  background: var(--brand-accent);
  color: #FFFFFF;
  font-size: var(--fs-xs);
  font-weight: var(--fw-black);
  text-align: center;
  border-radius: var(--radius-xs);
  letter-spacing: 0.3px;
  animation: confirm-pulse 1s ease-in-out infinite;
}
@keyframes confirm-pulse {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.65; }
}

/* Rodapé "Aguardando garçom" nos cards Pronto */
.kds-waiting {
  text-align: center;
  margin-top: 6px;
  font-size: var(--fs-xs);
  color: var(--text-muted);
  font-weight: var(--fw-semibold);
  font-style: italic;
}

/* ════════════════════════════════════════════
   ENTREGUES
════════════════════════════════════════════ */
.entregues-section {
  padding: 10px 16px 14px;
  background: var(--kds-surface-alt);
  border-top: 1px solid var(--kds-border);
}
.entregues-title {
  font-size: var(--fs-sm);
  font-weight: var(--fw-black);
  color: var(--status-delivered-color);
  text-transform: uppercase;
  letter-spacing: 0.6px;
}
.entregues-clear-btn {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: var(--kds-text-muted);
  padding: 5px 14px;
  border-radius: var(--radius-sm);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  cursor: pointer;
  font-family: inherit;
  transition: background var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
}
.entregues-clear-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.35);
  color: #FFFFFF;
}

.entregues-chips { display: flex; flex-wrap: wrap; gap: 6px; }

.entregue-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--status-delivered-bg);
  color: var(--status-delivered-color);
  border: 1px solid var(--status-delivered-border);
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  font-size: var(--fs-xs);
  cursor: pointer;
  user-select: none;
  transition: background var(--dur-fast), border-color var(--dur-fast), transform var(--dur-fast);
  max-width: 100%;
  min-width: 0;
}
.entregue-chip:hover {
  background: rgba(69, 123, 157, 0.22);
  border-color: var(--status-delivered-color);
}
.entregue-chip.active {
  background: var(--status-delivered-color);
  color: #FFFFFF;
  border-color: var(--status-delivered-color);
  transform: translateY(-1px);
}
.entregue-chip.active .chip-time,
.entregue-chip.active .chip-mesa { color: rgba(255, 255, 255, 0.9); }

.chip-order { font-weight: var(--fw-black); font-variant-numeric: tabular-nums; }
.chip-mesa  { font-weight: var(--fw-semibold); opacity: 0.8; font-size: 10px; padding: 0 2px; }
.chip-name  { font-weight: var(--fw-medium); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 110px; }
.chip-time  { font-size: 10px; opacity: 0.75; font-variant-numeric: tabular-nums; padding-left: 2px; }

/* ════════════════════════════════════════════
   TOOLTIP
════════════════════════════════════════════ */
.tooltip-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.15);
  z-index: var(--z-modal);
}
.tooltip-box {
  position: fixed;
  transform: translate(-50%, -100%);
  background: var(--surface);
  color: var(--text-primary);
  border-radius: var(--radius);
  padding: 14px 16px;
  min-width: 220px;
  max-width: 320px;
  box-shadow: var(--shadow-lg);
  border: 1px solid var(--border-default);
  font-size: var(--fs-sm);
  z-index: calc(var(--z-modal) + 1);
}
.tooltip-box::after {
  content: '';
  position: absolute;
  bottom: -7px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 14px;
  height: 14px;
  background: var(--surface);
  border-right: 1px solid var(--border-default);
  border-bottom: 1px solid var(--border-default);
}
.tooltip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  font-weight: var(--fw-bold);
  font-size: var(--fs-md);
  color: var(--text-primary);
  padding-bottom: 8px;
  margin-bottom: 8px;
  border-bottom: 1px solid var(--border-subtle);
}
.tooltip-item {
  padding: 4px 0;
  color: var(--text-secondary);
  line-height: 1.4;
}
.tooltip-item + .tooltip-item { border-top: 1px dashed var(--border-subtle); }
.tooltip-note {
  font-size: var(--fs-xs);
  color: var(--status-danger-color);
  font-style: italic;
  margin-top: 2px;
  padding-left: 4px;
}
.tooltip-close {
  margin-top: 10px;
  padding: 7px 14px;
  background: var(--brand-accent);
  color: #FFFFFF;
  text-align: center;
  border-radius: var(--radius-sm);
  cursor: pointer;
  font-weight: var(--fw-bold);
  font-size: var(--fs-sm);
  transition: background var(--dur-normal);
  user-select: none;
}
.tooltip-close:hover { background: var(--brand-accent-hover); }

/* ════════════════════════════════════════════
   LOGIN (fullscreen dark)
════════════════════════════════════════════ */
.fullscreen-center {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
  text-align: center;
  background: var(--kds-bg);
  color: #FFFFFF;
}
.fullscreen-center h2 { font-size: var(--fs-2xl); margin-bottom: 8px; color: #FFFFFF; }
.fullscreen-center p  { color: rgba(255, 255, 255, 0.7); margin-bottom: 32px; font-size: var(--fs-md); }

.logo-text {
  font-size: 32px;
  font-weight: var(--fw-black);
  color: var(--brand-accent);
  margin-bottom: 24px;
  letter-spacing: -0.5px;
}

.fullscreen-center .form-group label {
  color: rgba(255, 255, 255, 0.85);
  display: block;
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  margin-bottom: 6px;
  text-align: left;
}
.fullscreen-center .form-group { margin-bottom: 14px; }
.fullscreen-center .form-group input {
  width: 90%;
  padding: 11px 14px;
  border: 1.5px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-sm);
  font-size: 15px;
  background: rgba(255, 255, 255, 0.08);
  color: #FFFFFF;
  font-family: var(--font-base);
  outline: none;
  transition: border-color var(--dur-fast), background var(--dur-fast);
}
.fullscreen-center .form-group input::placeholder { color: rgba(255, 255, 255, 0.4); }
.fullscreen-center .form-group input:focus {
  border-color: var(--brand-accent);
  background: rgba(255, 255, 255, 0.12);
}
.fullscreen-center .error-msg {
  background: rgba(230, 57, 70, 0.2);
  border: 1px solid rgba(230, 57, 70, 0.4);
  color: #FFB3B9;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  margin-bottom: 14px;
  text-align: left;
}

.login-toggle { display: flex; gap: 8px; margin-bottom: 20px; }
.toggle-btn {
  flex: 1;
  padding: 10px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-sm);
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.7);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  cursor: pointer;
  font-family: inherit;
  transition: border-color var(--dur-fast), background var(--dur-fast), color var(--dur-fast);
}
.toggle-btn.active {
  border-color: var(--brand-accent);
  background: rgba(221, 111, 45, 0.18);
  color: #FFFFFF;
}

/* ════════════════════════════════════════════
   RESPONSIVIDADE
════════════════════════════════════════════ */
@media (min-width: 1600px) {
  .kds-container { gap: 14px; padding: 14px 20px; }
  .kds-card         { padding: 10px 12px; margin: 7px 9px; }
  .kds-order-id     { font-size: 15px; }
  .kds-items li     { font-size: 14px; }
}

@media (max-width: 768px) {
  .kds-container { grid-template-columns: 1fr; gap: 10px; padding: 10px; }
  .kds-column    { max-height: none; }
  .entregues-section { padding: 10px 12px; }
  .chip-name { max-width: 140px; }
}
